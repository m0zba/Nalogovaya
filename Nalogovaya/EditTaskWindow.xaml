<Window x:Class="Nalogovaya.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи"
        Height="570"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#C1876B">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование задачи"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#79553D"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Проект" Margin="0,0,0,6"/>
                <ComboBox x:Name="ProjectComboBox"
                          DisplayMemberPath="ProjectName"
                          SelectedValuePath="ProjectId"
                          Height="35"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Название задачи" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleTextBox"
                         Height="35"
                         Padding="8"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Описание" Margin="0,0,0,6"/>
                <TextBox x:Name="DescriptionTextBox"
                         Height="75"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Ответственный сотрудник" Margin="0,0,0,6"/>
                <ComboBox x:Name="EmployeeComboBox"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="UserId"
                          Height="35"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Срок выполнения" Margin="0,0,0,6"/>
                <DatePicker x:Name="DueDatePicker"
                            Height="35"
                            Margin="0,0,0,14"/>

                <TextBlock Text="Статус" Margin="0,0,0,6"/>
                <ComboBox x:Name="StatusComboBox"
                          Height="35"
                          Margin="0,0,0,14">
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Завершена"/>
                </ComboBox>

                <TextBlock Text="Приоритет" Margin="0,0,0,6"/>
                <ComboBox x:Name="PriorityComboBox"
                          Height="35"
                          Margin="0,0,0,10">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Отмена"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Сохранить"
                    Width="120"
                    Height="38"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
