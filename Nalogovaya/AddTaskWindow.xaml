<Window x:Class="Nalogovaya.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление задачи"
        Height="650"
        Width="600"
        MinHeight="600"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#C1876B">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Новая задача"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#79553D"/>

            <TextBlock Text="Заполните информацию о задаче"
                       FontSize="14"
                       Foreground="#FFF7F2"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <!-- Поля задачи -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Проект *"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <ComboBox x:Name="ProjectComboBox"
                          Height="38"
                          Padding="8"
                          Margin="0,0,0,16"
                          DisplayMemberPath="ProjectName"
                          SelectedValuePath="ProjectId"/>

                <TextBlock Text="Название задачи *"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="TitleTextBox"
                         Height="38"
                         Padding="8"
                         Margin="0,0,0,16"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Описание"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="DescriptionTextBox"
                         MinHeight="80"
                         Padding="8"
                         Margin="0,0,0,16"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Ответственный"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <ComboBox x:Name="EmployeeComboBox"
                          Height="38"
                          Padding="8"
                          Margin="0,0,0,16"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="UserId"/>

                <TextBlock Text="Срок выполнения"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <DatePicker x:Name="DueDatePicker"
                            Height="38"
                            Margin="0,0,0,16"/>

                <TextBlock Text="Приоритет"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <ComboBox x:Name="PriorityComboBox"
                          Height="38"
                          Padding="8"
                          Margin="0,0,0,16"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

                <TextBlock Text="Статус"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <ComboBox x:Name="StatusComboBox"
                          Height="38"
                          Padding="8"
                          Margin="0,0,0,16"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Завершена"/>
                </ComboBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Отмена"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button Content="Сохранить"
                    Width="130"
                    Height="40"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </Grid>
</Window>