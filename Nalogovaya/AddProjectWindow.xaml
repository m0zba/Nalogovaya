<Window x:Class="Nalogovaya.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление проекта"
        Height="560"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#C1876B">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#79553D"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Новый проект"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="#79553D"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Название проекта"/>
            <TextBox x:Name="ProjectNameTextBox"
                     Height="35"
                     Margin="0,5,0,15"
                     Padding="7"/>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="DescriptionTextBox"
                     Height="90"
                     Margin="0,5,0,15"
                     Padding="7"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Дата начала (необязательно)"/>
            <DatePicker x:Name="StartDatePicker"
                        Height="35"
                        Margin="0,5,0,15"/>

            <TextBlock Text="Дата окончания (необязательно)"/>
            <DatePicker x:Name="EndDatePicker"
                        Height="35"
                        Margin="0,5,0,15"/>

            <TextBlock Text="Статус"/>
            <ComboBox x:Name="StatusComboBox"
                      Height="35"
                      Margin="0,5,0,10"
                      SelectedIndex="0">
                <ComboBoxItem Content="Активен"/>
                <ComboBoxItem Content="Завершён"/>
                <ComboBoxItem Content="Приостановлен"/>
            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Отмена"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button Content="Сохранить"
                    Width="120"
                    Height="38"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
