<Window x:Class="Nalogovaya.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Nalogovaya"
        Height="560"
        Width="850"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#C1876B">

    <Window.Resources>

        <!-- Поля ввода -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Поле пароля -->
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Кнопки -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с фотографией -->
        <Border Grid.Column="0"
                Background="#79553D"
                ClipToBounds="True">

            <Grid>

                <!-- Фотография на фоне -->
                <Image Source="/Images/nalogovaya.jpg"
                       Stretch="UniformToFill"
                       Opacity="0.25"
                       IsHitTestVisible="False"/>



                <!-- Надписи поверх изображения -->
                <StackPanel VerticalAlignment="Center"
                            Margin="30">

                    <TextBlock Text="NALOGOVAYA"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Система учёта проектов и задач"
                               FontSize="15"
                               Foreground="#F3DED2"
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая панель авторизации -->
        <Grid Grid.Column="1"
              Margin="35">

            <Border Background="#D9A58D"
                    CornerRadius="14"
                    Padding="25">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Добро пожаловать!"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#79553D"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Войдите в свою учётную запись"
                               FontSize="14"
                               Foreground="#5E4032"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Логин"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="LoginTextBox"
                             Height="38"
                             FontSize="15"
                             Padding="8"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Пароль"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="38"
                                 FontSize="15"
                                 Padding="8"
                                 Margin="0,0,0,22"/>

                    <Button Content="Войти"
                            Height="43"
                            FontSize="15"
                            Background="#79553D"
                            Foreground="White"
                            BorderThickness="0"
                            Click="LoginButton_Click"/>

                    <Button Content="Зарегистрироваться"
                            Height="40"
                            FontSize="14"
                            Margin="0,10,0,0"
                            Background="#FFF7F2"
                            Foreground="#79553D"
                            BorderBrush="#79553D"
                            BorderThickness="1"
                            Click="RegisterButton_Click"/>

                    <TextBlock x:Name="MessageText"
                               Foreground="#A32222"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>