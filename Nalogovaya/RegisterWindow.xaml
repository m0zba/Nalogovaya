<Window x:Class="Nalogovaya.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация — Nalogovaya"
        Height="650"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#C1876B">

    <Window.Resources>

        <!-- Поля ввода -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Поля пароля -->
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Кнопки -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid Margin="35">

        <Border Background="#D9A58D"
                CornerRadius="14"
                Padding="25">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Создание аккаунта"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#79553D"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Заполните данные для регистрации"
                           FontSize="14"
                           Foreground="#4A3024"
                           Margin="0,0,0,22"/>

                <TextBlock Text="ФИО"
                           FontWeight="SemiBold"
                           Foreground="#4A3024"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="FullNameTextBox"
                         Height="38"
                         FontSize="15"
                         Padding="8"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Логин"
                           FontWeight="SemiBold"
                           Foreground="#4A3024"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="LoginTextBox"
                         Height="38"
                         FontSize="15"
                         Padding="8"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Пароль"
                           FontWeight="SemiBold"
                           Foreground="#4A3024"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="38"
                             FontSize="15"
                             Padding="8"
                             Margin="0,0,0,14"/>

                <TextBlock Text="Повторите пароль"
                           FontWeight="SemiBold"
                           Foreground="#4A3024"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="38"
                             FontSize="15"
                             Padding="8"
                             Margin="0,0,0,20"/>

                <Button Content="Создать аккаунт"
                        Height="43"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#79553D"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RegisterButton_Click"/>

                <TextBlock x:Name="MessageText"
                           Foreground="#A32222"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>