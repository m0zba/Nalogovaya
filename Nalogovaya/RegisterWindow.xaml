<Window x:Class="Nalogovaya.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация — Nalogovaya"
        Height="760"
        Width="500"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#C1876B">

    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Border Background="#D9A58D"
                    CornerRadius="14"
                    Padding="25">

                <StackPanel>
                    <TextBlock Text="Создание аккаунта"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#79553D"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Заполните данные для регистрации"
                               FontSize="14"
                               Foreground="#4A3024"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="ФИО"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="FullNameTextBox"
                             Height="38"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Логин"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="LoginTextBox"
                             Height="38"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Пароль"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="38"
                                 Margin="0,0,0,12"/>

                    <TextBlock Text="Повторите пароль"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 Height="38"
                                 Margin="0,0,0,16"/>

                    <TextBlock Text="Выберите роль"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#4A3024"
                               Margin="0,0,0,8"/>

                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button x:Name="AdminRoleButton"
                                Content="Admin"
                                Height="40"
                                Margin="2"
                                Click="AdminRoleButton_Click"/>

                        <Button x:Name="EditorRoleButton"
                                Content="Editor"
                                Height="40"
                                Margin="2"
                                Click="EditorRoleButton_Click"/>

                        <Button x:Name="UserRoleButton"
                                Content="User"
                                Height="40"
                                Margin="2"
                                Click="UserRoleButton_Click"/>
                    </UniformGrid>

                    <TextBlock x:Name="SelectedRoleText"
                               Text="Выбрана роль: User"
                               FontWeight="SemiBold"
                               Foreground="#4A3024"
                               Margin="0,0,0,14"/>

                    <Button Content="Создать аккаунт"
                            Height="45"
                            FontSize="15"
                            Background="#79553D"
                            Click="RegisterButton_Click"/>

                    <TextBlock x:Name="MessageText"
                               Foreground="#A32222"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
