<Window x:Class="Nalogovaya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления налоговой"
        Height="650"
        Width="1100"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#C1876B">

    <Window.Resources>

        <!-- Основной стиль кнопок -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Стиль таблиц -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#FFF7F2"/>
            <Setter Property="Foreground" Value="#3E2B22"/>
            <Setter Property="BorderBrush" Value="#79553D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFF7F2"/>
            <Setter Property="AlternatingRowBackground" Value="#F3DED2"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D9B9A8"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D9B9A8"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <!-- Заголовки таблиц -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#79553D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D9B9A8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Grid.Column="0"
                Background="#79553D">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top"
                            Margin="20,28,20,30">

                    <TextBlock Text="НАЛОГОВАЯ"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"/>

                    <TextBlock Text="Система управления"
                               Foreground="#F3DED2"
                               FontSize="13"
                               Margin="0,8,0,0"/>

                </StackPanel>

                <StackPanel>

                    <Button Content="Главная"
                            Height="48"
                            Margin="10,0,10,8"
                            Background="#A87558"
                            Foreground="White"
                            FontSize="15"
                            BorderThickness="0"
                            Click="HomeButton_Click"/>

                    <Button Content="Проекты"
                            Height="48"
                            Margin="10,0,10,8"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Click="ProjectsButton_Click"/>

                    <Button Content="Задачи"
                            Height="48"
                            Margin="10,0,10,8"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Click="TasksButton_Click"/>

                    <Button Content="Отчёты"
                            Height="48"
                            Margin="10,0,10,8"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Click="ReportsButton_Click"/>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock x:Name="PageTitle"
                           Text="Главная"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#79553D"/>

                <TextBlock x:Name="PageDescription"
                           Text="Добро пожаловать в систему управления."
                           FontSize="15"
                           Foreground="#4A3024"
                           Margin="0,8,0,0"/>

            </StackPanel>

            <!-- Рабочая карточка -->
            <Border Grid.Row="1"
                    Background="#FFF7F2"
                    CornerRadius="12"
                    Padding="25">

                <Grid>

                    <!-- Главная -->
                    <StackPanel x:Name="HomePanel">

                        <TextBlock Text="Добро пожаловать!"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#79553D"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Вы успешно вошли в систему."
                                   FontSize="16"
                                   Foreground="#4A3024"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Выберите раздел в меню слева:"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#4A3024"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="• Проекты — управление проектами."
                                   FontSize="15"
                                   Foreground="#4A3024"
                                   Margin="0,5"/>

                        <TextBlock Text="• Задачи — работа с задачами."
                                   FontSize="15"
                                   Foreground="#4A3024"
                                   Margin="0,5"/>

                        <TextBlock Text="• Отчёты — создание PDF-отчётов."
                                   FontSize="15"
                                   Foreground="#4A3024"
                                   Margin="0,5"/>

                    </StackPanel>

                    <!-- Рабочие разделы -->
                    <Grid x:Name="ContentPanel"
                          Visibility="Collapsed">

                        <TextBlock x:Name="SectionMessage"
                                   Text=""
                                   FontSize="18"
                                   Foreground="#4A3024"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Visibility="Collapsed"/>

                        <!-- Проекты -->
                        <Grid x:Name="ProjectsPanel"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0"
                                       Margin="0,0,0,15">

                                <Button x:Name="AddProjectButton"
                                        Content="＋ Добавить проект"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Background="#79553D"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="AddProjectButton_Click"/>

                                <Button x:Name="EditProjectButton"
                                        Content="Изменить"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Click="EditProjectButton_Click"/>

                                <Button x:Name="DeleteProjectButton"
                                        Content="Удалить"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Click="DeleteProjectButton_Click"/>

                                <Button Content="Обновить"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Click="RefreshProjectsButton_Click"/>

                            </WrapPanel>

                            <DataGrid x:Name="ProjectsDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="35"
                                      ColumnHeaderHeight="40"
                                      AlternationCount="2">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="№"
                                                        Binding="{Binding ProjectId}"
                                                        Width="55"/>

                                    <DataGridTextColumn Header="Название проекта"
                                                        Binding="{Binding ProjectName}"
                                                        Width="2*"/>

                                    <DataGridTextColumn Header="Описание"
                                                        Binding="{Binding Description}"
                                                        Width="3*"/>

                                    <DataGridTextColumn Header="Дата начала"
                                                        Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Дата окончания"
                                                        Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="120"/>

                                    <DataGridTextColumn Header="Статус"
                                                        Binding="{Binding ProjectStatus}"
                                                        Width="120"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Задачи -->
                        <Grid x:Name="TasksPanel"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0"
                                       Margin="0,0,0,15">

                                <Button x:Name="AddTaskButton"
                                        Content="＋ Добавить задачу"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Background="#79553D"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="AddTaskButton_Click"/>

                                <Button x:Name="EditTaskButton"
                                        Content="Изменить"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Click="EditTaskButton_Click"/>

                                <Button x:Name="DeleteTaskButton"
                                        Content="Удалить"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Click="DeleteTaskButton_Click"/>

                                <Button Content="Обновить"
                                        Padding="15,9"
                                        Margin="0,0,10,5"
                                        Click="RefreshTasksButton_Click"/>

                            </WrapPanel>

                            <DataGrid x:Name="TasksDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="35"
                                      ColumnHeaderHeight="40"
                                      AlternationCount="2">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="№"
                                                        Binding="{Binding TaskId}"
                                                        Width="55"/>

                                    <DataGridTextColumn Header="Проект"
                                                        Binding="{Binding ProjectName}"
                                                        Width="2*"/>

                                    <DataGridTextColumn Header="Название задачи"
                                                        Binding="{Binding Title}"
                                                        Width="2*"/>

                                    <DataGridTextColumn Header="Ответственный"
                                                        Binding="{Binding AssignedToName}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Срок"
                                                        Binding="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Статус"
                                                        Binding="{Binding Status}"
                                                        Width="120"/>

                                    <DataGridTextColumn Header="Приоритет"
                                                        Binding="{Binding Priority}"
                                                        Width="110"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Отчёты -->
                        <Grid x:Name="ReportsPanel"
                              Visibility="Collapsed">

                            <StackPanel>

                                <TextBlock Text="Формирование отчётов"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#79553D"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Создавайте PDF-отчёты на основе актуальных данных системы."
                                           FontSize="15"
                                           Foreground="#4A3024"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,25"/>

                                <Border Background="#F3DED2"
                                        CornerRadius="10"
                                        Padding="20">

                                    <StackPanel>

                                        <TextBlock Text="Отчёт по задачам"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#79553D"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Text="Включает проекты, названия задач, ответственных сотрудников, сроки, статусы и приоритеты."
                                                   FontSize="14"
                                                   Foreground="#4A3024"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,18"/>

                                        <Button Content="Сформировать PDF-отчёт"
                                                Padding="15,12"
                                                HorizontalAlignment="Left"
                                                Background="#79553D"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="CreateTasksReportButton_Click"/>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>